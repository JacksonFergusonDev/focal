#!/usr/bin/env bash
set -euo pipefail

# DESC: Searches the codebase for a regex pattern and copies the results.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"
if [[ $# -gt 0 ]] && [[ $1 =~ ^(-h|--help)$ ]]; then
  print_subcommand_help "search" \
    "Searches the codebase for a regex pattern and copies matching contexts to the clipboard." \
    "<pattern>"
  exit 0
fi

require_cmd "rg" "install ripgrep (e.g. 'brew install ripgrep')"

if [ $# -eq 0 ]; then
  die "missing search pattern" "usage: focal search <pattern>" 1
fi

matches=$(rg --context 5 "$1" . || true)

if [ -z "$matches" ]; then
  status_info "No matches found for '$1'."
  exit 0
fi

output_and_copy "$matches" "Search results copied to clipboard"
