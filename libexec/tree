#!/usr/bin/env bash
set -euo pipefail

# DESC: Copies the repository directory tree.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"

if [[ $# -gt 0 ]] && [[ $1 =~ ^(-h|--help)$ ]]; then
  print_subcommand_help "tree" \
    "Copies the repository directory tree to the clipboard." \
    ""
  exit 0
fi

tree_output=$(generate_repo_tree || true)
if [ -z "$tree_output" ]; then
  exit 0
fi

output_and_copy "$tree_output" "Repository tree copied to clipboard"
