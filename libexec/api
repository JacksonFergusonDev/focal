#!/usr/bin/env bash
set -euo pipefail

# DESC: Extracts and copies an overview of Python classes and functions.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"
if [[ $# -gt 0 ]] && [[ $1 =~ ^(-h|--help)$ ]]; then
  print_subcommand_help "api" \
    "Extracts and copies an overview of Python classes and functions to the clipboard." \
    ""
  exit 0
fi

require_cmd "rg" "install ripgrep (e.g. 'brew install ripgrep')"

matches=$(rg '^(class|def) ' . || true)

if [ -z "$matches" ]; then
  status_info "No Python classes or functions found."
  exit 0
fi

output_and_copy "$matches" "API overview copied to clipboard"
