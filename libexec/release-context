#!/usr/bin/env bash
set -euo pipefail

# DESC: Copies metadata and intent for PRs merged since the last release.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"

require_cmd "git"
require_gh_auth

BASE_REF=""
HEAD_REF="HEAD"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      print_subcommand_help "release-context" \
        "Copies metadata, PR intent, and raw commit history since the last release tag." \
        "[options]" \
        "--base <ref>    The base Git tag, commit, or branch to start the context from (exclusive). If not provided, it automatically detects the most recent Git tag." \
        "--head <ref>    The target Git tag, commit, or branch to end the context at (inclusive). Defaults to HEAD."
      exit 0
      ;;
    --base)
      BASE_REF="$2"
      shift 2
      ;;
    --head)
      HEAD_REF="$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [ -z "$BASE_REF" ]; then
  # 1. Resolve the latest tag, suppressing stderr if none exist
  LATEST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

  if [ -z "$LATEST_TAG" ]; then
    # Fallback: Find the chronological first commit of the repository
    LATEST_TAG=$(git rev-list --max-parents=0 HEAD | tail -n 1)
    TAG_DATE=$(git log -1 --format=%cI "$LATEST_TAG")
    HEADER_REF="Initial Commit"
  else
    # Get the ISO 8601 commit date of the tag
    TAG_DATE=$(git log -1 --format=%cI "$LATEST_TAG")
    HEADER_REF="$LATEST_TAG"
  fi
else
  # User provided base ref
  LATEST_TAG="$BASE_REF"
  if ! TAG_DATE=$(git log -1 --format=%cI "$LATEST_TAG" 2>/dev/null); then
    echo "Error: Invalid base ref '$BASE_REF'" >&2
    exit 1
  fi
  HEADER_REF="$LATEST_TAG"
fi

if ! HEAD_DATE=$(git log -1 --format=%cI "$HEAD_REF" 2>/dev/null); then
  echo "Error: Invalid head ref '$HEAD_REF'" >&2
  exit 1
fi

# 2. Extract repository architecture context
repo_context="$(generate_project_context)"

# 3. Pass the parameters to the Python backend
if ! formatted=$("$PYTHON_EXEC" -m focal.gh_release_context "$TAG_DATE" "$HEADER_REF" "$LATEST_TAG" "$HEAD_REF" "$HEAD_DATE"); then
  exit 1
fi

# 4. Concatenate and copy to clipboard
combined_payload="${repo_context}${formatted}"
output_and_copy "$combined_payload" "Copied repository and release context from $HEADER_REF to $HEAD_REF"
