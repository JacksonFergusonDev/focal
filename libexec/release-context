#!/usr/bin/env bash
set -euo pipefail

# DESC: Copies Git release membership, PR intent, and net impact.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"

LEVEL="patch"
PROJECT_CONTEXT=false
BACKEND_ARGS=()
MAX_TOKENS=24000

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      print_subcommand_help "release-context" \
        "Copies exact Git release membership, PR intent, changed paths, and release impact." \
        "[level] [options]" \
        "level                  minor, major, or patch (default: patch)." \
        "--minor, -m            Since the previous reachable stable x.y.0 tag." \
        "--major                Since the previous reachable stable x.0.0 tag." \
        "--patch                Since the previous reachable stable SemVer tag (default)." \
        "--base <ref>           Explicit exclusive base Git ref." \
        "--head <ref>           Explicit inclusive target; overrides --version tag selection." \
        "--version <tag>        Release version; targets the local tag if present, otherwise HEAD." \
        "--previous-release <tag>  Select the GitHub release used as a style reference." \
        "--bots <mode>          summary (default), include, or exclude." \
        "--request-timeout <s>  Maximum seconds per GitHub request (default: 10)." \
        "--github-timeout <s>   Total GitHub collection budget in seconds (default: 60)." \
        "--max-tokens <n>       Approximate output budget (default: 24000; 0 disables)." \
        "--diff                 Include the net diff between resolved endpoints." \
        "--path <pathspec>      Focus the diff; repeatable, requires --diff." \
        "--project-context      Append current checkout tree, status, and core manifests."
      exit 0
      ;;
    minor | --minor | -m)
      LEVEL="minor"
      shift
      ;;
    major | --major)
      LEVEL="major"
      shift
      ;;
    patch | --patch)
      LEVEL="patch"
      shift
      ;;
    --level | --since)
      [[ -n ${2:-} ]] || die "$1 requires an argument (major, minor, or patch)" "specify a release level" 1
      case "$2" in
        major | minor | patch) LEVEL="$2" ;;
        *) die "invalid release level '$2'. Expected 'major', 'minor', or 'patch'." "valid options: major, minor, patch" 1 ;;
      esac
      shift 2
      ;;
    --base | --head | --bots | --path | --version | --previous-release | --request-timeout | --github-timeout | --max-tokens)
      if [[ -z ${2:-} || $2 == --* ]]; then
        if [ "$1" = "--max-tokens" ]; then
          die "--max-tokens requires an argument: a numeric token budget" "use '--max-tokens 0' for full output, or '--max-tokens 100000' for a larger approximate budget (default: 24000)" 1
        fi
        die "$1 requires an argument" "run 'focal release-context --help' for usage" 1
      fi
      if [ "$1" = "--max-tokens" ]; then MAX_TOKENS="$2"; fi
      BACKEND_ARGS+=("$1" "$2")
      shift 2
      ;;
    --diff)
      BACKEND_ARGS+=("--diff")
      shift
      ;;
    --project-context)
      PROJECT_CONTEXT=true
      shift
      ;;
    *) die "unknown argument: $1" "run 'focal release-context --help' for usage" 1 ;;
  esac
done

require_cmd "git"
require_cmd "gh"

formatted=$("$PYTHON_EXEC" -m focal release-context --level "$LEVEL" "${BACKEND_ARGS[@]}") || exit 1
if [ "$PROJECT_CONTEXT" = true ]; then
  formatted+=$'\n# Project Background (current checkout, not the release snapshot)\n\n'
  formatted+=$'Tree is limited to six levels; core files are limited to their first 500 lines.\n\n'
  formatted+="$(generate_project_context)"
  formatted=$(printf "%s" "$formatted" | "$PYTHON_EXEC" -c 'import sys; from focal.release_output import limit_release_output; print(limit_release_output(sys.stdin.read(), int(sys.argv[1])), end="")' "$MAX_TOKENS")
fi
# The backend records immutable release endpoints; avoid unrelated checkout metadata.
FOCAL_OMIT_WORKSPACE=1 output_and_copy "$formatted" "Copied release context"
