#!/usr/bin/env bash
set -euo pipefail

# DESC: Locates files containing a specific symbol and copies full contents.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"

require_cmd "rg" "install ripgrep (e.g. 'brew install ripgrep')"

if [[ $# -gt 0 ]] && [[ $1 =~ ^(-h|--help)$ ]]; then
  print_subcommand_help "symbol" \
    "Locates files containing a specific symbol and copies full contents to the clipboard." \
    "<symbol>"
  exit 0
fi

if [ $# -eq 0 ]; then
  die "missing symbol name" "usage: focal symbol <symbol>" 1
fi

buffer=""

# Format files containing the symbol
buffer=$(rg -l "$1" | format_files_for_llm)

[ -z "$buffer" ] && exit 0

output_and_copy "$buffer" "Symbol context for '$1' copied to clipboard"
