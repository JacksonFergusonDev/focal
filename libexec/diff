#!/usr/bin/env bash
set -euo pipefail

# DESC: Copies a formatted git diff of uncommitted, staged, or all changes.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"

require_cmd "git"

# Default git diff arguments
diff_args=("-M")
target_name="working tree"
mode="unstaged"
thick_mode=false

# Parse basic flags
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      print_subcommand_help "diff" \
        "Copies a formatted git diff of uncommitted, staged, or all changes." \
        "[flags] [--] [path...]" \
        "--staged, --cached   Diff staged changes only." \
        "-a, --all            Diff all changes (staged and unstaged) against HEAD." \
        "--thick              Include the repository tree and full source code of modified files."
      exit 0
      ;;
    --staged | --cached)
      mode="staged"
      target_name="staged changes"
      shift
      ;;
    --all | -a)
      mode="all"
      target_name="all changes"
      shift
      ;;
    --thick)
      thick_mode=true
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      # Any remaining arguments are treated as paths
      break
      ;;
  esac
done

if [ $# -gt 0 ]; then
  diff_args+=("--" "$@")
  target_name="specified files"
else
  diff_args+=("--" "${GIT_DIFF_NOISE_EXCLUDES[@]}")
fi

# Find untracked files
if [ $# -gt 0 ]; then
  untracked_files=$(git ls-files --others --exclude-standard ${@+"$@"})
else
  untracked_files=$(git ls-files --others --exclude-standard -- "${GIT_DIFF_NOISE_EXCLUDES[@]}")
fi
has_untracked=false
if [ -n "$untracked_files" ]; then
  has_untracked=true
fi

diff_output=""
stat_output=""

if [ "$mode" == "staged" ]; then
  if [ $# -gt 0 ]; then
    if ! git diff --quiet ${@+"$@"} 2>/dev/null; then
      status_warn "You have unstaged changes not included in this diff. Use --all to include everything."
    fi
  else
    if ! git diff --quiet -- "${GIT_DIFF_NOISE_EXCLUDES[@]}" 2>/dev/null; then
      status_warn "You have unstaged changes not included in this diff. Use --all to include everything."
    fi
  fi
  if $has_untracked; then
    status_warn "You have untracked files not included in this diff. Use --all to include them."
  fi

  diff_output=$(git diff --staged "${diff_args[@]}")
  stat_output=$(git diff --staged --stat "${diff_args[@]}")

elif [ "$mode" == "unstaged" ]; then
  if [ $# -gt 0 ]; then
    if ! git diff --staged --quiet ${@+"$@"} 2>/dev/null; then
      status_warn "You have staged changes not included in this diff. Use --staged or --all."
    fi
  else
    if ! git diff --staged --quiet -- "${GIT_DIFF_NOISE_EXCLUDES[@]}" 2>/dev/null; then
      status_warn "You have staged changes not included in this diff. Use --staged or --all."
    fi
  fi
  if $has_untracked; then
    status_warn "You have untracked files not included in this diff. Use --all to include them."
  fi

  diff_output=$(git diff "${diff_args[@]}")
  stat_output=$(git diff --stat "${diff_args[@]}")

elif [ "$mode" == "all" ]; then
  head_ref="HEAD"
  if ! git rev-parse HEAD >/dev/null 2>&1; then
    head_ref="4b825dc642cb6eb9a060e54bf8d69288fbee4904" # Empty tree
  fi

  diff_output=$(git diff "$head_ref" "${diff_args[@]}")
  stat_output=$(git diff "$head_ref" --stat "${diff_args[@]}")

  # Append diffs for untracked files
  if $has_untracked; then
    while IFS= read -r file; do
      [ -z "$file" ] && continue
      untracked_diff=$(git diff --no-index /dev/null "$file" 2>/dev/null || true)
      if [ -n "$untracked_diff" ]; then
        if [ -n "$diff_output" ]; then
          diff_output+=$'\n'
        fi
        diff_output+="$untracked_diff"
      fi
    done <<<"$untracked_files"
  fi
fi

# Get overall status
if [ $# -gt 0 ]; then
  status_output=$(git status --short ${@+"$@"})
else
  status_output=$(git status --short -- "${GIT_DIFF_NOISE_EXCLUDES[@]}")
fi

if [ -z "$diff_output" ]; then
  echo "No changes detected in $target_name."
  exit 0
fi

# Assemble markdown buffer
buffer=""

if [ -n "$status_output" ]; then
  buffer+="### Status
\`\`\`
${status_output}
\`\`\`

"
fi

if [ -n "$stat_output" ]; then
  buffer+="### Summary
\`\`\`
${stat_output}
\`\`\`

"
fi

if [ -n "$diff_output" ]; then
  buffer+="### Diff
\`\`\`diff
${diff_output}
\`\`\`

"
fi

if $thick_mode; then
  buffer+="### Macroscopic Map
\`\`\`text
$(generate_repo_tree)
\`\`\`

### Contextual Grounding
"
  status_info "Generating thick diff contextual grounding..."

  modified_files=""
  if [ "$mode" == "staged" ]; then
    modified_files=$(git diff --staged --name-only --diff-filter=d "${diff_args[@]}")
  elif [ "$mode" == "unstaged" ]; then
    modified_files=$(git diff --name-only --diff-filter=d "${diff_args[@]}")
  elif [ "$mode" == "all" ]; then
    modified_files=$(git diff "$head_ref" --name-only --diff-filter=d "${diff_args[@]}")
    if $has_untracked; then
      while IFS= read -r file; do
        [ -n "$file" ] && modified_files+=$'\n'"$file"
      done <<<"$untracked_files"
    fi
  fi

  buffer+="$(format_files_for_llm <<<"$modified_files")"
fi

output_and_copy "$buffer" "Copied diff of $target_name"
