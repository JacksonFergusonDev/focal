#!/usr/bin/env bash
set -euo pipefail

# DESC: Copies GitHub issues alongside their comment threads.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"
require_gh_auth

# 1. Parse Arguments
STATE="open"
while [[ $# -gt 0 ]]; do
  case $1 in
    --all)
      STATE="all"
      shift
      ;;
    -h | --help)
      print_subcommand_help "issues" \
        "Copies GitHub issues alongside their comment threads." \
        "[options]" \
        "--all       Show both open and closed issues." \
        "-h, --help  Show this help message."
      exit 0
      ;;
    *)
      die "unknown argument: $1" "run 'focal issues --help' for usage" 1
      ;;
  esac
done

# 2. Fetch Issues
# We fetch everything (including the body) into a temporary JSON file to ensure the preview is instantaneous.
require_cmd "fzf"
require_cmd "jq"

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT
ISSUES_JSON="$TMP_DIR/issues.json"

status_info "Fetching issues..."
gh issue list --state "$STATE" --limit 100 --json number,title,state,author,body >"$ISSUES_JSON"

# Create a small wrapper script to avoid fzf quote-escaping nightmares
cat <<'EOF' >"$TMP_DIR/preview_wrapper.sh"
#!/usr/bin/env bash
jq -r --argjson id "$1" '.[] | select(.number == $id) | if .body == "" or .body == null then "# \(.title)\n\n*No description provided.*" else "# \(.title)\n\n\(.body)" end' "$2" | "$3" --stdin-markdown
EOF
chmod +x "$TMP_DIR/preview_wrapper.sh"

selected=$(jq -r '.[] | "\(.number)\t\(.state)\t\(.title)\t(@\(.author.login))"' "$ISSUES_JSON" |
  column -t -s $'\t' |
  fzf -m \
    --prompt="Select issues: " \
    --header="TAB: multi-select | CTRL-A: select all | ENTER: confirm" \
    --bind "ctrl-a:select-all,ctrl-d:deselect-all" \
    --preview "\"$TMP_DIR/preview_wrapper.sh\" {1} \"$ISSUES_JSON\" \"${REPO_ROOT}/lib/preview.sh\"" || true)

[ -z "$selected" ] && exit 0

# 3. Extract Issue IDs
# The first column is the issue number. We gather them into an array.
issue_ids=()
while read -r number _rest; do
  if [ -n "$number" ]; then
    issue_ids+=("$number")
  fi
done <<<"$selected"

if [ ${#issue_ids[@]} -eq 0 ]; then
  exit 0
fi

# 4. Fetch and Format Issues
# Our python script now supports fetching and formatting multiple issues at once
formatted=$("$PYTHON_EXEC" -m focal issues "${issue_ids[@]}")

if [ -z "$formatted" ]; then
  die "no content could be generated for the selected issues." "" 1
fi

# 5. Copy to Clipboard
# If one issue was selected, name it in the output. If multiple, show the count.
if [ ${#issue_ids[@]} -eq 1 ]; then
  success_msg="Copied context for Issue #${issue_ids[0]}"
else
  success_msg="Copied context for ${#issue_ids[@]} issues"
fi

output_and_copy "$formatted" "$success_msg"
