#!/usr/bin/env bash
set -euo pipefail

# DESC: Copies the contents of one or more files, with metadata.

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "${SCRIPT_DIR}/../lib/core.sh"

# Parse flags
mode="interactive"
if [[ $# -gt 0 ]]; then
  case "$1" in
    -h | --help)
      print_subcommand_help "files" \
        "Extracts and formats the contents of one or more files or directories for LLM prompting." \
        "[files/dirs...] | [flags]" \
        "-a, --all        Extract all valid non-noise files in the repository." \
        "-s, --staged     Extract all files currently staged in git." \
        "-m, --modified   Extract all files with uncommitted changes in the working tree."
      exit 0
      ;;
    -a | --all)
      mode="all"
      ;;
    -s | --staged)
      mode="staged"
      ;;
    -m | --modified)
      mode="modified"
      ;;
    *)
      mode="direct"
      ;;
  esac
fi

files=""
case "$mode" in
  all)
    require_cmd "fd"
    status_info "Discovering all valid files..."
    files=$(fd --type f --hidden --exclude .git)
    ;;
  staged)
    require_cmd "git"
    status_info "Discovering staged files..."
    files=$(git diff --name-only --cached --diff-filter=d)
    ;;
  modified)
    require_cmd "git"
    status_info "Discovering modified files..."
    files=$(git ls-files -m)
    ;;
  direct)
    require_cmd "fd"
    files=$(resolve_path_args "$@")
    ;;
  interactive)
    require_cmd "fzf"
    require_cmd "bat"
    require_cmd "fd"
    files=$(interactive_file_select "Files: " -m --header "TAB: multi-select | CTRL-A: select all | ENTER: confirm")
    ;;
esac

[ -z "$files" ] && {
  status_info "No files selected."
  exit 0
}

# 2. Process Files
buffer=""
added_count=0
empty_count=0
truncated_count=0
skipped_count=0
last_copied_file=""

while IFS= read -r file; do
  if [ -z "$file" ] || [ ! -f "$file" ]; then
    continue
  fi

  # Safely capture the markdown block AND the exit code without triggering set -e
  status_code=0
  section=$(format_file_for_llm "$file") || status_code=$?
  buffer="$buffer$section"$'\n\n'

  # Tally and log file states based on out-of-band signals
  case $status_code in
    11)
      status_skip "noise/binary: $file"
      skipped_count=$((skipped_count + 1))
      ;;
    12)
      status_add "(truncated): $file"
      truncated_count=$((truncated_count + 1))
      last_copied_file="$file"
      ;;
    10)
      status_add "(empty): $file"
      empty_count=$((empty_count + 1))
      last_copied_file="$file"
      ;;
    0)
      status_add "$file"
      added_count=$((added_count + 1))
      last_copied_file="$file"
      ;;
    *)
      # Failsafe for unexpected errors
      status_add "$file"
      added_count=$((added_count + 1))
      last_copied_file="$file"
      ;;
  esac
done <<<"$files"

total_copied=$((added_count + empty_count + truncated_count))

if [ "$total_copied" -eq 1 ] && [ -n "$last_copied_file" ]; then
  copy_msg="Copied $last_copied_file to clipboard"
else
  copy_msg="Copied context"
fi

# Copy payload to clipboard and print token estimate
output_and_copy "$buffer" "$copy_msg"

# 3. Print Summary Report
if [ "$skipped_count" -gt 0 ] || [ "$truncated_count" -gt 0 ] || [ "$empty_count" -gt 0 ]; then
  echo "" >&2
  echo "--- Extraction Summary ---" >&2
  echo "Added fully: $added_count files" >&2
  [ "$empty_count" -gt 0 ] && echo "Added empty: $empty_count files" >&2
  [ "$truncated_count" -gt 0 ] && echo "Truncated (>1500 lines): $truncated_count files" >&2
  [ "$skipped_count" -gt 0 ] && echo "Skipped (noise/binary): $skipped_count files" >&2
fi

exit 0
