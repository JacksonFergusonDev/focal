#!/usr/bin/env bash
set -euo pipefail

# Resolve paths
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(realpath "${SCRIPT_DIR}/..")"
LIBEXEC_DIR="${REPO_ROOT}/libexec"

# Internal helper to safely list commands for autocompletion
_list_commands() {
  for f in "$LIBEXEC_DIR"/*; do
    if [ -f "$f" ] && [ -x "$f" ]; then
      basename "$f"
    fi
  done | sort
}

# Internal helper to parse descriptions and print the help menu
_print_help() {
  echo "Usage: focal <command> [args]"
  echo ""
  echo "Available commands:"

  for f in "$LIBEXEC_DIR"/*; do
    if [ -f "$f" ] && [ -x "$f" ]; then
      local cmd_name
      cmd_name=$(basename "$f")

      # Extract the first line starting with '# DESC: '
      local desc
      desc=$(awk -F '# DESC: ' '/^# DESC: / {print $2; exit}' "$f")

      # Use printf for columnar alignment (reserves 15 chars for command name)
      printf "  %-15s %s\n" "$cmd_name" "${desc:-No description provided.}"
    fi
  done | sort
}

# Parse global flags
REPO_URL=""
declare -a REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      if [[ -z ${2:-} ]]; then
        echo "Error: --repo requires an argument." >&2
        exit 1
      fi
      REPO_URL="$2"
      shift 2
      ;;
    --repo=*)
      REPO_URL="${1#*=}"
      shift 1
      ;;
    *)
      REMAINING_ARGS+=("$1")
      shift 1
      ;;
  esac
done

# Restore positional parameters
set -- "${REMAINING_ARGS[@]}"

# Route: Autocompletion
if [ "${1:-}" == "--commands" ]; then
  _list_commands
  exit 0
fi

# Route: Global Help Menu (matches zero args, help, -h, or --help)
if [ $# -eq 0 ] || [[ $1 =~ ^(help|-h|--help)$ ]]; then
  _print_help
  exit 0
fi

COMMAND="$1"
shift || true

# Direct 1:1 mapping between subcommand and filename
SUBCOMMAND_BIN="${LIBEXEC_DIR}/${COMMAND}"

if [ ! -x "$SUBCOMMAND_BIN" ]; then
  echo "Error: Unknown command '$COMMAND'" >&2
  echo "Run 'focal help' for a list of available commands." >&2
  exit 1
fi

# Handle remote repository caching and execution
if [[ -n $REPO_URL ]]; then
  FOCAL_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/focal/repos"

  URL_HASH=$(echo -n "$REPO_URL" | shasum -a 256 | head -c 16)
  REPO_BASENAME=$(basename "$REPO_URL" .git)
  REPO_CACHE_PATH="$FOCAL_CACHE_DIR/${REPO_BASENAME}_${URL_HASH}"

  if [ ! -d "$REPO_CACHE_PATH" ]; then
    mkdir -p "$FOCAL_CACHE_DIR"
    echo >&2 "focal: Cloning remote repository into cache..."
    git clone --filter=blob:none "$REPO_URL" "$REPO_CACHE_PATH" >&2
  else
    echo >&2 "focal: Updating cached remote repository..."
    git -C "$REPO_CACHE_PATH" fetch --all >&2
    # Reset to the default branch's upstream (or fallback to HEAD if detached)
    # Using 'git remote show origin' to find the default branch is slow,
    # so we just reset to origin/HEAD or the current tracked branch.
    # To be safe and ensure we are on the latest default branch:
    git -C "$REPO_CACHE_PATH" remote set-head origin -a >&2 || true
    git -C "$REPO_CACHE_PATH" reset --hard origin/HEAD >&2 || true
  fi

  cd "$REPO_CACHE_PATH"

  # Execute normally so the shell regains control if needed, though exec is fine
  # since we don't need a trap anymore for cached repos.
  exec "$SUBCOMMAND_BIN" "$@"
else
  # Standard local execution
  exec "$SUBCOMMAND_BIN" "$@"
fi
