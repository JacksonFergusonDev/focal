#!/usr/bin/env bash
set -euo pipefail

# Resolve paths
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(realpath "${SCRIPT_DIR}/..")"
LIBEXEC_DIR="${REPO_ROOT}/libexec"
source "${REPO_ROOT}/lib/core.sh"

# Internal helper to safely list commands for autocompletion
_list_commands() {
  for f in "$LIBEXEC_DIR"/*; do
    if [ -f "$f" ] && [ -x "$f" ]; then
      basename "$f"
    fi
  done | sort
}

# Internal helper to parse descriptions and print the help menu
_print_help() {
  # ANSI colors (disabled if stdout is not a terminal)
  local bold="" cyan="" reset=""
  if [ -t 1 ]; then
    bold="\033[1m"
    cyan="\033[36m"
    reset="\033[0m"
  fi

  # Terminal width — fall back to 80 if tput is unavailable or not a TTY
  local term_width=80
  if [ -t 1 ] && command -v tput >/dev/null 2>&1; then
    term_width=$(tput cols)
  fi

  # Collect all commands and descriptions, find the longest command name
  local -a cmd_names=()
  local -a cmd_descs=()
  local max_cmd_len=0

  for f in "$LIBEXEC_DIR"/*; do
    if [ -f "$f" ] && [ -x "$f" ]; then
      local name
      name=$(basename "$f")
      local desc
      desc=$(awk -F '# DESC: ' '/^# DESC: / {print $2; exit}' "$f")
      cmd_names+=("$name")
      cmd_descs+=("${desc:-No description provided.}")
      if [ "${#name}" -gt "$max_cmd_len" ]; then
        max_cmd_len="${#name}"
      fi
    fi
  done

  # Layout constants
  local indent=2  # leading spaces before command
  local col_gap=3 # gap between command column and description
  local cmd_col_width=$((max_cmd_len + col_gap))
  local desc_col_width=$((term_width - indent - cmd_col_width))
  # Guard against very narrow terminals
  if [ "$desc_col_width" -lt 20 ]; then desc_col_width=20; fi

  # Word-wrap a string to a given width, with a hanging indent for wrapped lines
  _wrap_desc() {
    local text="$1"
    local width="$2"
    local hang_indent="$3" # prefix for continuation lines
    local line="" word=""
    local first=1
    for word in $text; do
      if [ "$first" -eq 1 ]; then
        line="$word"
        first=0
      elif [ $((${#line} + 1 + ${#word})) -le "$width" ]; then
        line="$line $word"
      else
        printf "%s\n" "$line"
        printf "%s" "$hang_indent"
        line="$word"
      fi
    done
    [ -n "$line" ] && printf "%s\n" "$line"
  }

  # Print header
  printf "${bold}Usage:${reset} focal [global flags] <command> [args]\n\n"
  printf "${bold}Global flags:${reset}\n"
  printf "  %-$((cmd_col_width - 1))s %s\n" "--repo <url>" "Run the command on a remote GitHub repository (caches locally)"
  printf "\n${bold}Available commands:${reset}\n"

  # Build a sorted index
  local -a sorted_indices=()
  local num_cmds="${#cmd_names[@]}"
  for ((i = 0; i < num_cmds; i++)); do sorted_indices+=("$i"); done
  # Bubble sort by name (small N, fine for a help menu)
  for ((i = 0; i < num_cmds; i++)); do
    for ((j = i + 1; j < num_cmds; j++)); do
      if [[ ${cmd_names[${sorted_indices[$i]}]} > ${cmd_names[${sorted_indices[$j]}]} ]]; then
        local tmp="${sorted_indices[$i]}"
        sorted_indices[$i]="${sorted_indices[$j]}"
        sorted_indices[$j]="$tmp"
      fi
    done
  done

  # Print each command row with word-wrapped description
  local hang_indent
  hang_indent="$(printf '%*s' $((indent + cmd_col_width)) '')"

  for idx in "${sorted_indices[@]}"; do
    local name="${cmd_names[$idx]}"
    local desc="${cmd_descs[$idx]}"

    # Print command name (colored, left-padded)
    printf "%${indent}s${cyan}${bold}%-${cmd_col_width}s${reset}" "" "$name"

    # Print description with word-wrap
    _wrap_desc "$desc" "$desc_col_width" "$hang_indent"
  done
}

# Parse global flags
REPO_URL=""
declare -a REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      if [[ -z ${2:-} ]]; then
        die "--repo requires an argument." "specify a repository URL, e.g. '--repo https://github.com/org/repo'" 1
      fi
      REPO_URL="$2"
      shift 2
      ;;
    --repo=*)
      REPO_URL="${1#*=}"
      shift 1
      ;;
    *)
      REMAINING_ARGS+=("$1")
      shift 1
      ;;
  esac
done

# Restore positional parameters
set -- "${REMAINING_ARGS[@]}"

# Route: Autocompletion
if [ "${1:-}" == "--commands" ]; then
  _list_commands
  exit 0
fi

# Route: Global Help Menu (matches zero args, help, -h, or --help)
if [ $# -eq 0 ] || [[ $1 =~ ^(help|-h|--help)$ ]]; then
  _print_help
  exit 0
fi

COMMAND="$1"
shift || true

# Direct 1:1 mapping between subcommand and filename
SUBCOMMAND_BIN="${LIBEXEC_DIR}/${COMMAND}"

if [ ! -x "$SUBCOMMAND_BIN" ]; then
  die "unknown command '$COMMAND'" "run 'focal help' for a list of available commands" 1
fi

# Handle remote repository caching and execution
if [[ -n $REPO_URL ]]; then
  FOCAL_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/focal/repos"

  URL_HASH=$(echo -n "$REPO_URL" | shasum -a 256 | head -c 16)
  REPO_BASENAME=$(basename "$REPO_URL" .git)
  REPO_CACHE_PATH="$FOCAL_CACHE_DIR/${REPO_BASENAME}_${URL_HASH}"

  if [ ! -d "$REPO_CACHE_PATH" ]; then
    mkdir -p "$FOCAL_CACHE_DIR"
    status_info "Cloning remote repository into cache..."
    git clone --filter=blob:none "$REPO_URL" "$REPO_CACHE_PATH" >&2
  else
    status_info "Updating cached remote repository..."
    git -C "$REPO_CACHE_PATH" fetch --all >&2
    # Reset to the default branch's upstream (or fallback to HEAD if detached)
    # Using 'git remote show origin' to find the default branch is slow,
    # so we just reset to origin/HEAD or the current tracked branch.
    # To be safe and ensure we are on the latest default branch:
    git -C "$REPO_CACHE_PATH" remote set-head origin -a >&2 || true
    git -C "$REPO_CACHE_PATH" reset --hard origin/HEAD >&2 || true
  fi

  cd "$REPO_CACHE_PATH"

  # Execute normally so the shell regains control if needed, though exec is fine
  # since we don't need a trap anymore for cached repos.
  exec "$SUBCOMMAND_BIN" "$@"
else
  # Standard local execution
  exec "$SUBCOMMAND_BIN" "$@"
fi
